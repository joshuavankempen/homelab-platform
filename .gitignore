# --- secrets: never commit plaintext ---
# Talos machine configs contain certificates and the cluster CA key.
# talhelper renders them from talconfig.yaml + talsecret.sops.yaml at apply time.
talsecret.yaml
talsecret.*.yaml
!talsecret.sops.yaml
clusterconfig/
kubeconfig
talosconfig
*.decrypted.yaml
*-unsealed.yaml
secret-*.yaml
!*-sealedsecret.yaml

# --- OpenTofu / Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# backend.hcl names a private project. Its .example documents the shape.
backend.hcl
!backend.hcl.example
crash.log
tofu.log
# .terraform.lock.hcl is committed on purpose. It pins the exact provider
# version and its checksums, so every machine resolves the same provider.
# An ignored lock file makes a run non-reproducible.

# --- Helm ---
charts/
*.tgz

# --- editors / OS ---
.DS_Store
Thumbs.db
.idea/
*.swp

# --- python ---
# Byte cache from running the discovery script. Generated, never edited.
__pycache__/
*.py[cod]

# --- opentofu plan files ---
# A saved plan holds resolved values, and may hold sensitive ones. It is a
# review artifact for one apply, never a committed file.
*.tfplan
tfplan
